# Ghostty — matches the Windows Terminal Ubuntu profile look
# (Catppuccin Mocha, Cascadia Mono 12). Omarchy ships Ghostty.
#
# Install Cascadia Mono if you want the same typeface:
#   https://github.com/microsoft/cascadia-code/releases
# Without it, Ghostty falls back to its default font.

theme = Catppuccin Mocha
font-family = Cascadia Mono
font-size = 9
font-style = Semibold
cursor-style = bar

# Clipboard behavior: selections work like Windows/Cursor, and Omarchy's
# SUPER+V terminal shortcut (Shift+Insert) pastes the normal clipboard.
copy-on-select = clipboard
clipboard-write = allow
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard
